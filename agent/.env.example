# Linux/macOS: copie para .env e aplique chmod 600 .env.
# Windows: proteja o arquivo com ACL do usuário; Credential Manager é a evolução recomendada.
# O agente não finge aplicar automaticamente permissões POSIX no Windows.
URL_BASE_SEI=https://sei.exemplo.gov.br
URL_CONTROLE_SEI=https://sei.exemplo.gov.br/controlador.php?acao=procedimento_controlar
UNIDADE_SEI=UNIDADE_EXEMPLO
CAMINHO_ESTADO_SESSAO_SEI=playwright/.auth/sei.json
# Opcionais: listas com o mesmo layout paginado e a mesma origem do SEI.
URL_ATRIBUIDOS_SEI=
URLS_MARCADORES_SEI_JSON=

# Use somente chave pública (anon ou sb_publishable); nunca service role/sb_secret.
URL_SUPABASE=https://projeto.supabase.co
CHAVE_PUBLICA_SUPABASE=sb_publishable_substitua
EMAIL_USUARIO_SUPABASE=usuario@example.gov.br
SENHA_USUARIO_SUPABASE=substitua-localmente
ID_INSTALACAO_AGENTE_SUPABASE=10000000-0000-4000-8000-000000000001
# Segredo local com pelo menos 32 caracteres; nunca versionar ou imprimir em logs.
TOKEN_INSTALACAO_AGENTE_SUPABASE=substitua-por-token-aleatorio-com-32-caracteres

AGENTE_SEM_INTERFACE=true
INTERVALO_SINCRONIZACAO_MINUTOS=10
MAXIMO_PAGINAS_SEI=1000

PROXY_ATIVADO=false
SERVIDOR_PROXY=http://proxy.exemplo:8080
USUARIO_PROXY=
SENHA_PROXY=
IGNORAR_PROXY=localhost,127.0.0.1
# Necessário somente ao enviar credenciais por proxy remoto HTTP/SOCKS sem TLS.
PERMITIR_AUTENTICACAO_PROXY_INSEGURA=false
