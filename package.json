{
  "name": "sei-notifier",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Extensão de navegador leve para monitoramento de novos processos no SEI com extração de assunto e radar nativo.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-icons.js && vite build && vite build --config vite.content.config.ts",
    "package": "npm run build && node scripts/empacotar.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.js",
    "screenshots": "node scripts/gerar-screenshots.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
